VITE_SUPABASE_URL=IMPORT_YOUR_URL
VITE_SUPABASE_PUBLISHABLE_KEY=IMPORT_YOUR_ANON_KEY
# Cloudflare Turnstile site key for the waitlist form. This test key always
# passes; production uses the chairo.app widget's key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Show the pricing section and its nav link
VITE_SHOW_PRICING=false
VITE_SHOW_SOCIAL_LINKS=false
