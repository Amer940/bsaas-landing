# Cloudflare Pages. iOS reads this file only as JSON, and it has no extension
# to say so.
/.well-known/apple-app-site-association
  Content-Type: application/json

# The admin page: keep it out of search results, also for crawlers that
# don't run JS (the page sets the same as a meta tag).
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
